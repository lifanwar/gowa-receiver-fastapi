APP_NAME=gowa-webhook-api
REDIS_URL=redis://localhost:6379/0

GOWA_WEBHOOK_SECRET=change-this-secret

STREAM_PREFIX=wa:incoming
STREAM_MAXLEN=1000

DEDUP_PREFIX=wa:dedup
DEDUP_TTL_SECONDS=86400

# Kosongkan jika semua device boleh diterima.
# Isi dengan device_id dari GOWA jika ingin membatasi.
ALLOWED_DEVICES=sales,support,finance